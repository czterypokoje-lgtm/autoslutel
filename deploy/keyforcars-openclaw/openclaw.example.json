{
  "gateway": {
    "mode": "local",
    "bind": "loopback",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": "REPLACE_WITH_RANDOM_TOKEN"
    },
    "controlUi": {
      "enabled": false
    }
  },
  "browser": {
    "enabled": true,
    "evaluateEnabled": false,
    "defaultProfile": "keyforcars",
    "headless": true,
    "noSandbox": false,
    "ssrfPolicy": {
      "allowedHostnames": [
        "business.hanpanel.com.tr"
      ]
    },
    "profiles": {
      "keyforcars": {
        "cdpPort": 18800,
        "executablePath": "/srv/keyforcars-openclaw/browsers/chromium-1255/chrome-linux64/chrome"
      }
    },
    "extraArgs": [
      "--disable-background-networking"
    ]
  },
  "channels": {},
  "cron": {
    "enabled": false
  },
  "discovery": {
    "mdns": {
      "mode": "off"
    }
  },
  "plugins": {
    "allow": [
      "browser"
    ],
    "slots": {
      "memory": "none"
    }
  }
}
