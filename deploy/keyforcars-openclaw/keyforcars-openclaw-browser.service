[Unit]
Description=Restore KeyForCars demo browser tab
After=keyforcars-openclaw.service
Requires=keyforcars-openclaw.service

[Service]
Type=oneshot
User=kfc-claw
Group=kfc-claw
WorkingDirectory=/srv/keyforcars-openclaw
Environment=HOME=/srv/keyforcars-openclaw
Environment=PATH=/opt/node-v24.22.3-linux-x64/bin:/usr/sbin:/usr/bin:/bin
Environment=OPENCLAW_STATE_DIR=/srv/keyforcars-openclaw/state
Environment=OPENCLAW_CONFIG_PATH=/srv/keyforcars-openclaw/state/openclaw.json
ExecStart=/opt/node-v24.22.3-linux-x64/bin/node /srv/keyforcars-openclaw/ensure-browser.mjs
TimeoutStartSec=70
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
UMask=0077
