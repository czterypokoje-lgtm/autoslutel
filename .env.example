# ── Supabase (leads) ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vercel Blob (customer photos) ────────────────────────────────
bbauto_READ_WRITE_TOKEN=

# ── Admin access ─────────────────────────────────────────────────
# REQUIRED. Without these, /offline-conversions, /account, /demo-*
# and /api/export-conversions return 401 (fail closed, by design).
ADMIN_USER=
ADMIN_PASSWORD=
# Bearer token for scripted/cron access to /api/export-conversions
EXPORT_SECRET=

# ── Rate limiting (Upstash Redis via Vercel KV) ──────────────────
# Optional but strongly recommended. Without these the limiter fails
# OPEN, so /api/leads, /api/upload and /api/kenteken are unthrottled.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=

# ── E-mail (Resend) ───────────────────────────────────────────────
# Without RESEND_API_KEY, order confirmations and the lead e-mail alert
# never send — a lead is still saved, nobody is told.
RESEND_API_KEY=
MAIL_FROM=

# Inbound mail, for the postvak at /admin/berichten.
#
# Resend hands out an address on its own domain, so nothing about
# info@autosleutel24.nl has to move: set a forwarding rule in the host's
# webmail pointing at the <id>.resend.app address, and add the webhook for
# the email.received event at /api/inbox/email/webhook.
#
# The signing secret Resend gives you goes here. Without it that route
# answers 401 to everything, real mail included — it fails closed on
# purpose, the same way the ElevenLabs webhook does.
RESEND_WEBHOOK_SECRET=
LEAD_ALERT_EMAIL=

# ── Lead alert + technician messaging (Telegram) ─────────────────
# TELEGRAM_BOT_TOKEN alone only enables technician messages. The lead
# alert also needs TELEGRAM_OFFICE_CHAT_ID, or new leads only reach the
# office by e-mail (see /admin/instellingen for live status of both).
TELEGRAM_BOT_TOKEN=
TELEGRAM_OFFICE_CHAT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ── WhatsApp voice/chat agent (ElevenLabs) ────────────────────────
# Without these, only the plain wa.me buttons in the CRM work.
ELEVENLABS_API_KEY=
ELEVENLABS_WHATSAPP_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_TECHNICIAN_AGENT_ID=
ELEVENLABS_JOB_OFFER_TEMPLATE_NAME=
ELEVENLABS_JOB_OFFER_TEMPLATE_LANG=
# Escalation: the agent rings the office for a noodgeval or a caller who asks
# for a human (src/lib/elevenlabsCall.ts). Unset = Telegram only, no ringing.
# Forwarding a live *phone* call needs nothing here — that is transfer_to_number
# in the ElevenLabs console; see docs/elevenlabs-console-setup.md.
ELEVENLABS_BRIEFING_AGENT_ID=
ELEVENLABS_OUTBOUND_PHONE_NUMBER_ID=
OFFICE_PHONE=

# ── Payments (Mollie) ─────────────────────────────────────────────
# Without this the webshop cannot start a payment.
MOLLIE_API_KEY=

# ── Ad spend sync (Google Ads / Microsoft Ads) ────────────────────
# Feeds daily ad cost into the CRM's financial overview. Credentials can
# be present while still reporting "partial" on /admin/instellingen —
# the API client behind these was intentionally left unbuilt; see that
# page's own comment before assuming a figure here means it's live.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
BING_ADS_DEVELOPER_TOKEN=
BING_ADS_REFRESH_TOKEN=

# ── OpenAI Ads conversion pixel ───────────────────────────────────
# Server-side fallback for phone-call leads (src/app/api/track-call-
# conversion). No-ops safely if unset.
OPENAI_ADS_API_KEY=

# ── Google Maps (service-area map, RDW lookups, brandstof per klus) ──
GOOGLE_MAPS_API_KEY=

# ── Brandstofkosten per klus ──────────────────────────────────────
# Euro per kilometer. A finished job gets cost_travel = round trip × this
# rate, measured via the Distance Matrix (src/lib/jobTravelCost.ts).
# Unset falls back to 0.23, the Dutch untaxed norm. Not a secret.
# Changing it does not rewrite jobs already costed — what a job cost in
# fuel is a historical fact.
FUEL_EUR_PER_KM=0.23

# ── Cron / internal API auth ──────────────────────────────────────
CRON_SECRET=
AGENT_API_TOKEN=

# ── Dev-only ───────────────────────────────────────────────────────
# Hides the consent banner in local dev. Ignored in production — see
# src/components/ConsentBanner: running without it live is a
# Telecommunicatiewet art. 11.7a breach, not a styling choice.
NEXT_PUBLIC_HIDE_CONSENT=

# Origin of the /lp ad-landing zone (the Namaken Next app deploy), e.g.
# https://namaken.vercel.app — proxied in at autosleutel24.nl/lp/* by
# next.config.ts so Google Ads final URLs stay on this domain. Unset and the
# zone simply is not rewritten.
LP_ZONE_ORIGIN=
CALL_CLICK_WINDOW_MINUTES=45
